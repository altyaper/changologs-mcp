{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.altyaper/changologs-mcp",
  "description": "Create, search, and list Changologs logs and tasks",
  "repository": {
    "url": "https://github.com/altyaper/changologs-mcp",
    "source": "github"
  },
  "version": "1.0.0",
  "remotes": [
    { "type": "streamable-http", "url": "https://changologs-mcp.workers.dev/mcp" }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "changologs-mcp",
      "version": "1.0.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "Your API key for the service",
          "isRequired": true,
          "format": "string",
          "isSecret": true,
          "name": "YOUR_API_KEY"
        }
      ]
    }
  ]
}
